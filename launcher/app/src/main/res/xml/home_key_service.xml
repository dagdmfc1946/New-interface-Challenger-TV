<?xml version="1.0" encoding="utf-8"?>
<!-- Challenger adaptation: observe only Google TV window changes. No key filtering or
     window-content retrieval; the handler redirects only its registered HOME activities. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.google.android.apps.tv.launcherx"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false"
    android:canRequestFilterKeyEvents="false"
    android:description="@string/home_key_description" />
